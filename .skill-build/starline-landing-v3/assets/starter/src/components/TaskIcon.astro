---
interface Props {
  name: "cart" | "cost" | "gmv" | "channels" | "retargeting" | "scale";
}

const { name } = Astro.props;
---

<svg class="task-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
  {name === "cart" && <path d="M5 7h3l2.4 12h11.8l2.5-8H9.2M13 25h.01M22 25h.01" />}
  {name === "cost" && <path d="m5 22 6-6 5 3 10-10M20 9h6v6M7 26h18" />}
  {name === "gmv" && <><circle cx="16" cy="16" r="10" /><path d="M16 6v10l7 4" /></>}
  {name === "channels" && <><circle cx="14" cy="14" r="7" /><path d="m19.5 19.5 7 7M10 14h8M14 10v8" /></>}
  {name === "retargeting" && <path d="M8 10a10 10 0 0 1 16 2M24 8v4h-4M24 22a10 10 0 0 1-16-2M8 24v-4h4" />}
  {name === "scale" && <path d="M7 25 25 7M16 7h9v9M7 16v9h9" />}
</svg>
