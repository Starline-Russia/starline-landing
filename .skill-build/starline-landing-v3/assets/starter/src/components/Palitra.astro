---
import { palitraAreas } from "../data/site";
---

<div class="palitra-layout shell">
  <div class="palitra-heading">
    <p class="eyebrow">Palitra</p>
    <h2>AI помогает<br /><span>видеть рост раньше</span></h2>
    <p>Palitra ускоряет анализ, отчётность и распределение бюджетов — решения остаются под контролем senior-специалиста.</p>
  </div>

  <div class="palitra-system">
    <div class="palitra-orbit orbit-horizontal" aria-hidden="true"></div>
    <div class="palitra-orbit orbit-vertical" aria-hidden="true"></div>
    <div class="palitra-core" aria-label="Palitra"><span class="star" aria-hidden="true"></span><strong>Palitra</strong></div>
    {palitraAreas.map((area, index) => (
      <article class={`palitra-area area-${index + 1}`}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h3>{area.title}</h3>
        <p>{area.text}</p>
      </article>
    ))}
  </div>

  <p class="human-control"><span aria-hidden="true">✦</span> Senior-специалист контролирует AI-процессы</p>
</div>
