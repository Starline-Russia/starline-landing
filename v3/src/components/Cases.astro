---
import { Image } from "astro:assets";
import { cases } from "../data/site";
---

<div class="section-heading shell">
  <p class="eyebrow dark">Практика</p>
  <h2>Кейсы нашей команды</h2>
</div>

<div class="case-list shell">
  {cases.map((caseStudy) => (
    <article class="case-study">
      <header class="case-header">
        <Image
          class="case-image"
          src={caseStudy.image}
          alt={caseStudy.imageAlt}
          width={caseStudy.width}
          height={caseStudy.height}
          widths={[480, 720, 960]}
          sizes="(max-width: 760px) 100vw, 38vw"
          loading="lazy"
          format="webp"
        />
        <span>{caseStudy.category}</span>
        <h3>{caseStudy.title}</h3>
      </header>
      <div class="case-body">
        <div class="case-metric"><strong>{caseStudy.metric}</strong><span>{caseStudy.metricLabel}</span></div>
        <ul>{caseStudy.points.map((point) => <li>{point}</li>)}</ul>
        <blockquote>{caseStudy.quote}</blockquote>
      </div>
    </article>
  ))}
</div>
