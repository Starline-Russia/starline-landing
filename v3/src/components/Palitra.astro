---
import { palitraAreas } from "../data/site";
---

<div class="palitra-layout shell">
  <div class="palitra-heading">
    <p class="eyebrow">Новый подход к performance</p>
    <h2>Используем <span>AI-платформу</span> для управления маркетинговыми процессами</h2>
    <p>Palitra ускоряет анализ, отчётность и распределение бюджетов — решения остаются под контролем специалиста</p>
  </div>

  <div class="palitra-system">
    <div class="palitra-core" aria-label="Palitra">
      <img
        class="palitra-logo"
        src="/assets/palitra-logo-512.png"
        alt=""
        aria-hidden="true"
        width="512"
        height="512"
      />
    </div>
    {palitraAreas.map((area) => (
      <article class="palitra-area">
        <img
          class="palitra-area-bullet"
          src="/assets/starline-logo-v8-1.png"
          alt=""
          aria-hidden="true"
          width="1024"
          height="1024"
        />
        <h3>{area.title}</h3>
        <p>{area.text}</p>
      </article>
    ))}
    <p class="human-control">Одобрение специалистом (HEETL)</p>
  </div>
</div>
