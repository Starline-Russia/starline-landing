---
import { services } from "../data/site";
---

<div class="section-heading centered shell-narrow">
  <h2>Все инструменты роста —<br /><span>в одной системе</span></h2>
  <p class="section-lead">Собираем каналы, аналитику и экспертизу вокруг роста новых клиентов и GMV.</p>
</div>

<div class="service-list shell" data-service-list>
  {services.map((service, index) => (
    <article class="service-item" data-open={index === 0 ? "true" : "false"}>
      <button
        class="service-toggle"
        type="button"
        aria-expanded={index === 0 ? "true" : "false"}
        aria-controls={`service-panel-${index}`}
        data-service-toggle
      >
        <span class="service-number">{String(index + 1).padStart(2, "0")}</span>
        <span class="service-title">{service.title}</span>
        <span class="service-arrow" aria-hidden="true">↗</span>
      </button>
      <div class="service-panel" id={`service-panel-${index}`}>
        <div>
          <p>{service.description}</p>
          <ul aria-label={`Инструменты: ${service.title}`}>
            {service.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </div>
    </article>
  ))}
</div>
